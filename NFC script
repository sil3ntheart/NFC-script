local djConnection
local lastDJText = ""

local function getStruggleTextLabel()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    local effects = playerGui:FindFirstChild("Effects")
    if not effects then return nil end
    
    local system = effects:FindFirstChild("AbilityStruggleSystem") or effects:FindFirstChild("AStruggleSystem")
    if not system then return nil end
    
    local frame = system:FindFirstChild("Frame")
    if not frame then return nil end
    
    return frame:FindFirstChild("TextLabel")
end

local function getKeyCode(char)
    char = string.upper(char)
    if char:match("^[A-Z]$") then
        return Enum.KeyCode[char]
    end
    return nil
end

local function startDJChallenge(enabled)
    if not enabled then
        if djConnection then djConnection:Disconnect(); djConnection = nil end
        lastDJText = ""
        return
    end
    if djConnection or not RunService then return end
    
    djConnection = RunService.RenderStepped:Connect(function()
        if not flags.djChallenge then return end
        
        local textLabel = getStruggleTextLabel()
        
        if textLabel and textLabel.Visible then
            local currentText = textLabel.Text
            
            if #currentText == 1 and currentText ~= lastDJText then
                local keyCode = getKeyCode(currentText)
                
                if keyCode then
                    lastDJText = currentText
                    
                    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                    task.wait(0.02)
                    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
                end
            elseif #currentText == 0 then
                lastDJText = ""
            end
        end
    end)
end

