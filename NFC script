local friendCache = {}
local function refreshFriendsList()
    friendCache = {}
    pcall(function()
        local success, pages = pcall(function() return Players:GetFriendsAsync(LocalPlayer.UserId) end)
        if success and pages then
            local cursor = pages
            while cursor do
                for _, item in ipairs(cursor:GetCurrentPage()) do
                    friendCache[item.Id] = true
                end
                if cursor.IsFinished then break end
                local nextOk, nextCursor = pcall(function() return cursor:AdvanceToNextPageAsync() end)
                if not nextOk then break end
                cursor = nextCursor
            end
        end
    end)
end
refreshFriendsList()

local function isFriend(player)
    if not flags.ignoreFriends then return false end
    if friendCache[player.UserId] then return true end
    local success, result = pcall(function() return player:IsFriendsWith(LocalPlayer.UserId) end)
    if success and result then
        friendCache[player.UserId] = true
        return true
    end
    return false
end

