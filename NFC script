    value = "cobalt", flag = "Theme", callback = function(sel) window:ChangeTheme(sel) end })

settingsTab:CreateDivider()
settingsTab:CreateSection({ name = "Configuration" })
settingsTab:CreateButton({ name = "Save Config Now", callback = function() window:Save(); window:Toast({ title = "Saved" }) end })
settingsTab:CreateButton({ name = "Load Config Now", callback = function() window:Load(); window:Toast({ title = "Loaded" }) end })

settingsTab:CreateDivider()
settingsTab:CreateSection({ name = "Staff Monitor" })
settingsTab:CreateToggle({ name = "Notify if staff join", flag = "StaffNotify", value = false, callback = onStaffToggleChanged })
settingsTab:CreateButton({ name = "List Current Staff in Server", callback = function()
    local entries, staffCount = {}, 0
    for _, p in ipairs(Players:GetPlayers()) do
        local ok, rank = pcall(function() return p:GetRankInGroup(STAFF_GROUP_ID) end)
        if ok and rank >= 2 then
            local ok2, role = pcall(function() return p:GetRoleInGroup(STAFF_GROUP_ID) end)
            local isStaff = rank >= STAFF_RANK_THRESHOLD
            entries[#entries+1] = { displayName = p.DisplayName, username = p.Name, rank = rank, role = ok2 and role or "Unknown", isStaff = isStaff }
            if isStaff then staffCount = staffCount + 1 end
        end
    end
    if #entries == 0 then window:Notify({ title = "Staff Monitor", content = "No staff in server.", duration = 4 }); return end
    table.sort(entries, function(a, b) return a.rank > b.rank end)
    local header = staffCount == 0 and ("Staff: 0 (" .. #entries .. " below-threshold)") or ("Staff: " .. staffCount)
    local lines = { header, "" }
    for _, e in ipairs(entries) do
        lines[#lines+1] = string.format("%s %s — Rank %d: %s", e.isStaff and "★" or "·", e.displayName, e.rank, e.role)
    end
    window:Notify({ title = "Staff Monitor", content = table.concat(lines, "\n"), duration = 12 })
end })

settingsTab:CreateDivider()
settingsTab:CreateSection({ name = "Danger Zone" })
settingsTab:CreateButton({ name = "Eject Script", description = "Stops all features and closes the UI.",
    callback = function()
        for k in pairs(CD_KIT_LISTS) do flags[k] = false end
        flags.djChallenge = false
        if djConnection then djConnection:Disconnect(); djConnection = nil end
        flags.noclip = false; applyNoclip(false)
        flags.autoHerb = false; startAutoHerb(false)
        flags.hitboxEnabled = false; resetAimHitbox()
        flags.rageMode = false; startRageMode(false)
        flags.targetVisEnabled = false; clearTargetVis()
        flags.espEnabled = false
        for player in pairs(espEntries) do destroyESP(player) end
        flags.totemESP = false
        for part in pairs(totemEntries) do removeTotemObjects(part) end
        totemEntries = {}
        staffNotifyEnabled = false
        if staffOnJoinConnection then pcall(function() staffOnJoinConnection:Disconnect() end); staffOnJoinConnection = nil end
        for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
        connections = {}
        pcall(function() window:Unload() end)
    end })

