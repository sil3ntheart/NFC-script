-- ============================================================
-- Hitbox Expander
-- ============================================================
local hitboxConnection

local function resetAllHitboxes()
    flags.hitboxEnabled = false
    if hitboxConnection then hitboxConnection:Disconnect(); hitboxConnection = nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local orig = originalHRP[p]
                hrp.Size = orig or Vector3.new(2, 2, 1)
                hrp.Transparency = 1
                hrp.CanCollide = false
            end
        end
        originalHRP[p] = nil
    end
end

local function updateHitboxVisuals()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if flags.hitboxShow and flags.hitboxEnabled then
                    hrp.Transparency = 0.7
                else
                    hrp.Transparency = 1
                end
            end
        end
    end
end

local function applyHitbox(enabled)
    if not enabled then
        if hitboxConnection then hitboxConnection:Disconnect(); hitboxConnection = nil end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local orig = originalHRP[p]
                    hrp.Size = orig or Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                    hrp.CanCollide = false
                end
            end
        end
        return
    end
    if hitboxConnection then return end
    hitboxConnection = RunService.Heartbeat:Connect(function()
        if not flags.hitboxEnabled then return end
        local sz = Vector3.new(flags.hitboxSize, flags.hitboxSize, flags.hitboxSize)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    if not originalHRP[p] then originalHRP[p] = hrp.Size end
                    hrp.Size = sz
                    hrp.Transparency = flags.hitboxShow and 0.7 or 1
                    hrp.CanCollide = false
                end
            end
        end
    end)
end

-- ============================================================
-- Dj Challenge
-- ============================================================
local djConnection
local function getDJChallengeLabel()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, name in ipairs({ "DjChallenge", "DJChallenge", "DJ_Challenge", "ChallengeGui", "DJJChallenge" }) do
        local g = pg:FindFirstChild(name)
        if g then
            local lbl = g:FindFirstChild("TextLabel", true)
            if lbl and lbl:IsA("TextLabel") then return lbl end
        end
    end
    return nil
end

local lastDJText = ""
local function startDJChallenge(enabled)
    if not enabled then
        if djConnection then djConnection:Disconnect(); djConnection = nil end
        lastDJText = ""
        return
    end
    if djConnection then return end
    djConnection = RunService.RenderStepped:Connect(function()
        if not flags.djChallenge then return end
        local lbl = getDJChallengeLabel()
        if not lbl or not lbl.Visible then return end
        local txt = lbl.Text
        if #txt == 1 and txt ~= lastDJText then
            local key = Enum.KeyCode[string.upper(txt)]
            if key then
                lastDJText = txt
                VirtualInputManager:SendKeyEvent(true, key, false, game)
                task.wait(0.02)
                VirtualInputManager:SendKeyEvent(false, key, false, game)
            end
        elseif #txt == 0 then
            lastDJText = ""
        end
    end)
end

