    if gui then
        local label = gui:FindFirstChild("DisplayName")
        if label and label:IsA("TextLabel") then text = label.Text end
    end
    if not text or text == "" then return nil end
    local first, bloodline = text:match("^(%S+)%s+(.+)$")
    if not bloodline or bloodline == "" then return nil end
    bloodline = bloodline:gsub("%s+$", "")
    if bloodline == "" or (first and first:lower() == bloodline:lower()) then return nil end
    if player and bloodline:lower() == player.Name:lower() then return nil end
    return bloodline
end

local function getSpeciesText(character, gui)
    gui = gui or getTitlesGui(character)
    if gui then
        for _, n in ipairs({ "SPECIE","Specie","Species","SPECIES" }) do
            local l = gui:FindFirstChild(n)
            if l and l:IsA("TextLabel") and l.Text ~= "" then return tostring(l.Text) end
        end
    end
    return nil
end

local function getClassColor(character)
    if not character then return nil, nil end
    local s = character:FindFirstChild("Statuses")
    if not s then return nil, nil end
    for _, n in ipairs(CLASS_PRIORITY) do
        local f = s:FindFirstChild(n)
        if f and f:IsA("BoolValue") and f.Value then return n, CLASS_COLORS[n] end
    end
    return nil, nil
end

local function getActiveSpellName(casting)
    if not casting then return nil end
    for _, c in ipairs(casting:GetChildren()) do
        if c:IsA("BoolValue") and c.Value then return c.Name end
    end
    return nil
end

local function isInvisible(casting)
    if not casting then return false end
    local i = casting:FindFirstChild("Invisique")
    return i and i:IsA("BoolValue") and i.Value
end

local ROW_HEIGHT = 14
local BAR_HEIGHT = 3
local BAR_GAP = 2

local function makeLabel(parent, size)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size = UDim2.new(1, 0, 0, size + 2)
    l.Position = UDim2.new(0, 0, 0, 0)
    l.Font = Enum.Font.GothamBold
    l.TextSize = size
    l.TextColor3 = Color3.new(1, 1, 1)
    l.TextStrokeTransparency = 0.3
    l.TextStrokeColor3 = Color3.new(0, 0, 0)
    l.Text = ""
    l.Visible = false
    l.Parent = parent
    return l
end

local function createESP(player)
    if espEntries[player] then return espEntries[player] end
    local b = Instance.new("BillboardGui")
    b.Name = "RayfieldESP_" .. player.Name
    b.Size = UDim2.new(0, 200, 0, 120)
    b.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    b.AlwaysOnTop = true
    b.LightInfluence = 0
    b.ResetOnSpawn = false
    local frame = Instance.new("Frame")
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.Parent = b

    local speciesLbl = makeLabel(frame, 13)
    local nameLbl    = makeLabel(frame, 14)
    local bloodLbl   = makeLabel(frame, 13)
    local spellLbl   = makeLabel(frame, 13)
    local invisLbl   = makeLabel(frame, 13)
    local distLbl    = makeLabel(frame, 12)

    local hpBarBg = Instance.new("Frame")
    hpBarBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    hpBarBg.BackgroundTransparency = 0.4
    hpBarBg.BorderSizePixel = 0
    hpBarBg.Size = UDim2.new(0.4, 0, 0, BAR_HEIGHT)
    hpBarBg.Visible = false
    hpBarBg.Parent = frame
    local hpFill = Instance.new("Frame")
    hpFill.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
    hpFill.BorderSizePixel = 0
    hpFill.Size = UDim2.new(1, 0, 1, 0)
    hpFill.Parent = hpBarBg

    espEntries[player] = {
        gui = b, frame = frame,
        species = speciesLbl, name = nameLbl, bloodline = bloodLbl,
        spell = spellLbl, invis = invisLbl, distance = distLbl,
        hpBarBg = hpBarBg, hpBarFill = hpFill,
    }
    return espEntries[player]
end

local function destroyESP(player)
    local e = espEntries[player]
    if e and e.gui then pcall(function() e.gui:Destroy() end) end
    espEntries[player] = nil
end

local function trackPlayer(p)
    if p == LocalPlayer or trackedPlayers[p] then return end
    if trackedCount >= MAX_TRACKED then return end
    trackedPlayers[p] = true
    trackedCount = trackedCount + 1
end

local function untrackPlayer(p)
    destroyESP(p)
    if trackedPlayers[p] then trackedPlayers[p] = nil; trackedCount = trackedCount - 1 end
    espState[p] = nil
    currentStaff[p] = nil
end

trackConn(Players.PlayerAdded:Connect(trackPlayer))
trackConn(Players.PlayerRemoving:Connect(untrackPlayer))
for _, p in ipairs(Players:GetPlayers()) do trackPlayer(p) end

local function renderESP()
    local now = tick()
    if (now - lastESPRender) < 1/60 then return end
    lastESPRender = now
    if not flags.espEnabled then
        for _, e in pairs(espEntries) do if e.gui then e.gui.Enabled = false end end
        return
    end
    local camPos = Camera.CFrame.Position
    for player in pairs(trackedPlayers) do
        local e = espEntries[player] or createESP(player)
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (char and hrp and hum and hum.Health > 0) then
            e.gui.Enabled = false
        else
            local dist = (camPos - hrp.Position).Magnitude
            if dist > flags.maxDist then
                e.gui.Enabled = false
            else
                if e.gui.Adornee ~= hrp then e.gui.Adornee = hrp; e.gui.Parent = hrp end
                e.gui.Enabled = true
                local st = espState[player]
                if not st or st.char ~= char or not st.stamp or (now - st.stamp) > 3 then
                    local gui = getTitlesGui(char)
                    st = st or {}
                    st.char = char; st.stamp = now
                    st.speciesText = getSpeciesText(char, gui)
                    st.bloodlineText = getCharacterBloodline(char, gui, player)
                    st.casting = getCastingFolder(player)
                    local _, c = getClassColor(char)
                    st.speciesColor = c or flags.classColor
                    espState[player] = st
                end
                if st.casting and not isAlive(st.casting) then st.casting = getCastingFolder(player) end

                local speciesText = (flags.species and st.speciesText and st.speciesText ~= "") and st.speciesText or nil
                
                local isFriendPlayer = isFriend(player)
                local nameRichText = nil
                local nameColor = Color3.new(1, 1, 1)
                
                if flags.name then
                    local displayName = player.DisplayName
                    if displayName and displayName ~= player.Name then
                        nameRichText = string.format('<font size="14">%s</font> <font size="11">(%s)</font>', player.Name, displayName)
                    else
                        nameRichText = string.format('<font size="14">%s</font>', player.Name)
                    end
                    
                    if isFriendPlayer then
                        nameColor = flags.friendColor
                    end
                end

                local bloodText = (flags.bloodline and st.bloodlineText and st.bloodlineText ~= "") and st.bloodlineText or nil
                local spellName = flags.spellESP and getActiveSpellName(st.casting) or nil
                local isInvis = flags.visESP and isInvisible(st.casting) or false
                local showHP = flags.healthBar and hum.MaxHealth > 0
                local distText = flags.distance and (floor(dist) .. " studs") or nil

                e.species.Visible = false; e.name.Visible = false
                e.bloodline.Visible = false; e.spell.Visible = false
                e.invis.Visible = false; e.distance.Visible = false
                e.hpBarBg.Visible = false
                local y = 0
                if speciesText then
                    e.species.Text = speciesText
                    e.species.TextColor3 = st.speciesColor or flags.classColor
                    e.species.Position = UDim2.new(0, 0, 0, y)
                    e.species.Visible = true
                    y = y + ROW_HEIGHT
                end
                if nameRichText then
                    e.name.RichText = true
                    e.name.Text = nameRichText
                    e.name.TextColor3 = nameColor
                    e.name.Position = UDim2.new(0, 0, 0, y)
                    e.name.Visible = true
                    y = y + ROW_HEIGHT + 2
                end
                if bloodText then
                    e.bloodline.Text = bloodText
                    e.bloodline.Position = UDim2.new(0, 0, 0, y)
                    e.bloodline.Visible = true
                    y = y + ROW_HEIGHT
                end
                if spellName then
                    e.spell.Text = spellName
                    e.spell.TextColor3 = flags.spellColor
                    e.spell.Position = UDim2.new(0, 0, 0, y)
                    e.spell.Visible = true
                    y = y + ROW_HEIGHT
                end
                if isInvis then
                    e.invis.Text = "Invisible"
                    e.invis.TextColor3 = Color3.fromRGB(255, 80, 80)
                    e.invis.Position = UDim2.new(0, 0, 0, y)
                    e.invis.Visible = true
                    y = y + ROW_HEIGHT
                end
                if showHP then
                    local pct = clamp(hum.Health / hum.MaxHealth, 0, 1)
                    e.hpBarFill.Size = UDim2.new(pct, 0, 1, 0)
                    e.hpBarFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - pct), 255 * pct, 80)
                    e.hpBarBg.Position = UDim2.new(0.3, 0, 0, y)
                    e.hpBarBg.Visible = true
                    y = y + BAR_HEIGHT + BAR_GAP
                end
                if distText then
                    e.distance.Text = distText
                    e.distance.Position = UDim2.new(0, 0, 0, y)
                    e.distance.Visible = true
                    y = y + ROW_HEIGHT
                end
                e.gui.Size = UDim2.new(0, 200, 0, math.max(y, 1))
            end
        end
    end
end

if RunService then
    trackConn(RunService.RenderStepped:Connect(function() pcall(renderESP) end))
end

