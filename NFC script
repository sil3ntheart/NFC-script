do
    pcall(function()
        local remote = ReplicatedStorage:FindFirstChild("AntiCheatRemote")
        if not remote then return end
        if type(getgc) ~= "function" or type(debug) ~= "table" then return end
        local WANTED_UPVALUES = 7
        local function holdsRemote(fn)
            for i = 1, WANTED_UPVALUES do
                local ok, v = pcall(debug.getupvalue, fn, i)
                if ok and v == remote then return true end
            end
            return false
        end
        local function findFlag()
            local ok, objs = pcall(getgc)
            if not ok then return nil end
            for _, v in ipairs(objs) do
                if type(v) == "function" then
                    local ok2, info = pcall(debug.getinfo, v)
                    if ok2 and info and info.nups == WANTED_UPVALUES and holdsRemote(v) then return v end
                end
            end
            return nil
        end
        local flag = findFlag()
        if not flag then return end
        if type(hookfunction) == "function" then
            pcall(hookfunction, flag, function() end)
            return
        end
        task.spawn(function()
            while true do
                for i = 1, WANTED_UPVALUES do
                    local ok, v = pcall(debug.getupvalue, flag, i)
                    if ok then
                        if type(v) == "number" and v > 0 then pcall(debug.setupvalue, flag, i, 0)
                        elseif type(v) == "table" then pcall(table.clear, v) end
                    end
                end
                task.wait(1)
            end
        end)
    end)
end

