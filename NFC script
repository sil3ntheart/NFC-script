local espEntries = {}
local espState   = {}
local MAX_TRACKED = 50
local trackedPlayers, trackedCount = {}, 0
local ESP_RENDER_INTERVAL = 1 / 60
local lastESPRender = 0

local function getTitlesGui(character)
    if not character then return nil end
    local head = character:FindFirstChild("Head")
    if head then
        local titleAtt = head:FindFirstChild("TitleAtt")
        if titleAtt then
            local gui = titleAtt:FindFirstChild("TitlesGui")
            if gui then return gui end
        end
    end
    local lt = getLivingThings()
    if lt then
        local entry = lt:FindFirstChild(character.Name)
        if entry then
            local titleAtt = entry:FindFirstChild("TitleAtt")
            if titleAtt then
                local gui = titleAtt:FindFirstChild("TitlesGui")
                if gui then return gui end
            end
            local gui = entry:FindFirstChild("TitlesGui")
            if gui then return gui end
        end
    end
    return nil
end

local function getCharacterBloodline(character, gui, player)
    local text = nil
    if gui then
        local label = gui:FindFirstChild("DisplayName")
        if label and label:IsA("TextLabel") then text = label.Text end
    end
    if not text or text == "" then return nil end
    local first, bloodline = text:match("^(%S+)%s+(.+)$")
    if not bloodline or bloodline == "" then return nil end
    bloodline = bloodline:gsub("%s+$", "")
    if bloodline == "" then return nil end
    if first and first:lower() == bloodline:lower() then return nil end
    if player and bloodline:lower() == player.Name:lower() then return nil end
    return bloodline
end

local function getSpeciesText(character, gui)
    gui = gui or getTitlesGui(character)
    if gui then
        for _, labelName in ipairs({ "SPECIE", "Specie", "Species", "SPECIES" }) do
            local label = gui:FindFirstChild(labelName)
            if label and label:IsA("TextLabel") then
                local text = label.Text
                if text and text ~= "" then return tostring(text) end
            end
        end
    end
    return nil
end

local function getClassColor(character)
    if not character then return nil, nil end
    local statuses = character:FindFirstChild("Statuses")
    if not statuses then return nil, nil end
    for _, name in ipairs(CLASS_PRIORITY) do
        local flag = statuses:FindFirstChild(name)
        if flag and flag:IsA("BoolValue") and flag.Value then
            return name, CLASS_COLORS[name]
        end
    end
    return nil, nil
end

local function getActiveSpellName(casting)
    if not casting then return nil end
    for _, child in ipairs(casting:GetChildren()) do
        if child:IsA("BoolValue") and child.Value then
            return child.Name
        end
    end
    return nil
end

local function isInvisible(casting)
    if not casting then return false end
    local invis = casting:FindFirstChild("Invisique")
    return invis and invis:IsA("BoolValue") and invis.Value == true
end

local ROW_HEIGHT = 14
local BAR_HEIGHT = 3
local BAR_GAP    = 2

local function makeLabel(parent, size, color)
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 0, size + 2)
    lbl.Position = UDim2.new(0, 0, 0, 0)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = size
    lbl.TextColor3 = color or Color3.new(1, 1, 1)
    lbl.TextStrokeTransparency = 0.3
    lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
    lbl.Text = ""
    lbl.Visible = false
    lbl.Parent = parent
    return lbl
end

local function createESP(player)
    if espEntries[player] then return espEntries[player] end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "RayfieldESP_" .. player.Name
    billboard.Adornee = nil
    billboard.Size = UDim2.new(0, 200, 0, 120)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.ResetOnSpawn = false

    local frame = Instance.new("Frame")
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.Parent = billboard

    local speciesLbl = makeLabel(frame, 13)
    local nameLbl    = makeLabel(frame, 14)
    local bloodLbl   = makeLabel(frame, 13)
    local spellLbl   = makeLabel(frame, 13)
    local invisLbl   = makeLabel(frame, 13)
    local distLbl    = makeLabel(frame, 12)

    local hpBarBg = Instance.new("Frame")
    hpBarBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    hpBarBg.BackgroundTransparency = 0.4
    hpBarBg.BorderSizePixel = 0
    hpBarBg.Size = UDim2.new(0.4, 0, 0, BAR_HEIGHT)
    hpBarBg.Position = UDim2.new(0.3, 0, 0, 0)
    hpBarBg.Visible = false
    hpBarBg.Parent = frame

    local hpBarFill = Instance.new("Frame")
    hpBarFill.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
    hpBarFill.BorderSizePixel = 0
    hpBarFill.Size = UDim2.new(1, 0, 1, 0)
    hpBarFill.Parent = hpBarBg

    local entry = {
        gui = billboard, frame = frame,
        species = speciesLbl, name = nameLbl, bloodline = bloodLbl,
        spell = spellLbl, invis = invisLbl, distance = distLbl,
        hpBarBg = hpBarBg, hpBarFill = hpBarFill,
    }
    espEntries[player] = entry
    return entry
end

local function destroyESP(player)
    local e = espEntries[player]
    if e and e.gui then pcall(function() e.gui:Destroy() end) end
    espEntries[player] = nil
end

local function hideAllESP(e)
    if not e then return end
    e.gui.Enabled = false
end

local function trackPlayer(player)
    if player == LocalPlayer then return end
    if trackedPlayers[player] then return end
    if trackedCount >= MAX_TRACKED then return end
    trackedPlayers[player] = true
    trackedCount = trackedCount + 1
end

local function untrackPlayer(player)
    destroyESP(player)
    if trackedPlayers[player] then
        trackedPlayers[player] = nil
        trackedCount = trackedCount - 1
    end
    espState[player] = nil
end

trackConn(Players.PlayerAdded:Connect(trackPlayer))
trackConn(Players.PlayerRemoving:Connect(untrackPlayer))
for _, p in ipairs(Players:GetPlayers()) do trackPlayer(p) end

local function placeRow(lbl, frame, y)
    lbl.Position = UDim2.new(0, 0, 0, y)
    lbl.Visible = true
end

local function renderESP()
    local now = tick()
    if (now - lastESPRender) < ESP_RENDER_INTERVAL then return end
    lastESPRender = now

    if not flags.espEnabled then
        for _, e in pairs(espEntries) do hideAllESP(e) end
        return
    end

    local camPos  = Camera.CFrame.Position
    local maxDist = flags.maxDist

    for player in pairs(trackedPlayers) do
        local e = espEntries[player]
        if not e then e = createESP(player) end

        local char = player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not (char and hrp and hum and hum.Health > 0) then
            hideAllESP(e)
            continue
        end

        local dist = (camPos - hrp.Position).Magnitude
        if dist > maxDist then
            hideAllESP(e)
            continue
        end

        if e.gui.Adornee ~= hrp then
            e.gui.Adornee = hrp
            e.gui.Parent = hrp
        end
        e.gui.Enabled = true

        local st = espState[player]
        if not st or st.char ~= char or not st.guiStamp or (now - st.guiStamp) > 3 then
            local gui = getTitlesGui(char)
            st = st or {}
            st.char = char
            st.guiStamp = now
            st.speciesText   = getSpeciesText(char, gui)
            st.bloodlineText = getCharacterBloodline(char, gui, player)
            st.casting       = getCastingFolder(player)
            local _, clsColor = getClassColor(char)
            st.speciesColor  = clsColor or flags.classColor
            espState[player] = st
        end

        if st.casting and not isAlive(st.casting) then
            st.casting = getCastingFolder(player)
        end

        local speciesText = (flags.species and st.speciesText and st.speciesText ~= "") and st.speciesText or nil
        local nameText    = flags.name and player.Name or nil
        local bloodText   = (flags.bloodline and st.bloodlineText and st.bloodlineText ~= "") and st.bloodlineText or nil
        local spellName   = flags.spellESP and getActiveSpellName(st.casting) or nil
        local isInvis     = flags.visESP and isInvisible(st.casting) or false
        local showHP      = flags.healthBar and hum.MaxHealth > 0
        local distText    = flags.distance and (floor(dist) .. " studs") or nil

        e.species.Visible = false
        e.name.Visible = false
        e.bloodline.Visible = false
        e.spell.Visible = false
        e.invis.Visible = false
        e.distance.Visible = false
        e.hpBarBg.Visible = false

        local y = 0

        if speciesText then
            e.species.Text = speciesText
            e.species.TextColor3 = st.speciesColor or flags.classColor
            placeRow(e.species, e.frame, y)
            y += ROW_HEIGHT
        end

        if nameText then
            e.name.Text = nameText
            e.name.TextColor3 = Color3.new(1, 1, 1)
            placeRow(e.name, e.frame, y)
            y += ROW_HEIGHT
        end

        if bloodText then
            e.bloodline.Text = bloodText
            e.bloodline.TextColor3 = Color3.fromRGB(80, 160, 255)
            placeRow(e.bloodline, e.frame, y)
            y += ROW_HEIGHT
        end

        if spellName then
            e.spell.Text = spellName
            e.spell.TextColor3 = flags.spellColor
            placeRow(e.spell, e.frame, y)
            y += ROW_HEIGHT
        end

        if isInvis then
            e.invis.Text = "Invisible"
            e.invis.TextColor3 = Color3.fromRGB(255, 80, 80)
            placeRow(e.invis, e.frame, y)
            y += ROW_HEIGHT
        end

        if showHP then
            local pct = clamp(hum.Health / hum.MaxHealth, 0, 1)
            e.hpBarFill.Size = UDim2.new(pct, 0, 1, 0)
            e.hpBarFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - pct), 255 * pct, 80)
            e.hpBarBg.Position = UDim2.new(0.3, 0, 0, y)
            e.hpBarBg.Visible = true
            y += BAR_HEIGHT + BAR_GAP
        end

        if distText then
            e.distance.Text = distText
            e.distance.TextColor3 = Color3.new(1, 1, 1)
            placeRow(e.distance, e.frame, y)
            y += ROW_HEIGHT
        end

        e.gui.Size = UDim2.new(0, 200, 0, math.max(y, 1))
    end
end

trackConn(RunService.RenderStepped:Connect(function() pcall(renderESP) end))

