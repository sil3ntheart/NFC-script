-- TARGET & DYNAMIC HITBOX FINDER
-- ============================================================
local targetDotGui = nil
local currentAimTarget = nil
local currentExpandedHRP = nil
local currentExpandedOrigSize = nil

local function method_raycast()
    local mouse = UserInputService:GetMouseLocation()
    local unitRay = Camera:ViewportPointToRay(mouse.X, mouse.Y)
    
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    
    local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 2000, rayParams)
    if result and result.Instance then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        if model then
            local player = Players:GetPlayerFromCharacter(model)
            if player and player ~= LocalPlayer then
                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and not isFriend(player) then
                    return model
                end
            end
        end
    end
    return nil
end

local function method_cameraCone()
    local camPos = Camera.CFrame.Position
    local dir = Camera.CFrame.LookVector
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not isFriend(p) then
            local char = p.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if char and hrp and hum and hum.Health > 0 then
                local toChar = hrp.Position - camPos
                local d = toChar.Magnitude
                if d > 0 and d < bestDist then
                    if toChar.Unit:Dot(dir) >= 0.90 then 
                        best = char; bestDist = d 
                    end
                end
            end
        end
    end
    return best
end

local function findTarget()
    local target = method_raycast()
    if target then return target end
    return method_cameraCone()
end

local function clearTargetVis()
    if targetDotGui then pcall(function() targetDotGui:Destroy() end); targetDotGui = nil end
end

local function resetAimHitbox()
    if currentExpandedHRP then
        pcall(function()
            currentExpandedHRP.Size = currentExpandedOrigSize or Vector3.new(2, 2, 1)
            currentExpandedHRP.Transparency = 1
            currentExpandedHRP.CanCollide = false
            currentExpandedHRP.CollisionGroup = "Default"
        end)
        currentExpandedHRP = nil
        currentExpandedOrigSize = nil
    end
end

-- Checks if a player is being carried by us, or carrying us
local function isCarryingRelationship(char)
    local myEntry = getLivingEntry(LocalPlayer)
    local theirEntry = nil
    local theirPlayer = Players:GetPlayerFromCharacter(char)
    if theirPlayer then
        theirEntry = getLivingEntry(theirPlayer)
    end
    
    if myEntry then
        local carriedPerson = myEntry:FindFirstChild("CarriedPerson")
        local carriedBy = myEntry:FindFirstChild("CarriedBy")
        
        if carriedPerson and carriedPerson.Value == char.Name then return true end
        if carriedBy and carriedBy.Value ~= "" and theirPlayer and carriedBy.Value == theirPlayer.Name then return true end
    end
    
    if theirEntry and theirEntry:FindFirstChild("CarriedPerson") then
        if theirEntry.CarriedPerson.Value == LocalPlayer.Name then return true end
    end
    
    return false
end

local function updateAimHitbox()
    if not flags.hitboxEnabled then
        resetAimHitbox()
        return
    end

    local char = currentAimTarget
    if not char then
        resetAimHitbox()
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    local player = Players:GetPlayerFromCharacter(char)
    
    if isCarryingRelationship(char) then
        resetAimHitbox()
        return
    end

    if not hrp or not hum or hum.Health <= 0 or (player and isFriend(player)) then
        resetAimHitbox()
        return
    end

    if currentExpandedHRP ~= hrp then
        resetAimHitbox()
        currentExpandedHRP = hrp
        currentExpandedOrigSize = hrp.Size
    end

    local sz = Vector3.new(flags.hitboxSize, flags.hitboxSize, flags.hitboxSize)
    hrp.Size = sz
    hrp.Transparency = flags.hitboxShow and 0.7 or 1
    hrp.CanCollide = false
    setHitboxGroup(hrp)
end

if RunService then
    trackConn(RunService.RenderStepped:Connect(function()
        currentAimTarget = findTarget()

        if not flags.targetVisEnabled then 
            clearTargetVis()
        elseif currentAimTarget then
            local head = currentAimTarget:FindFirstChild("Head") or currentAimTarget:FindFirstChild("HumanoidRootPart")
            if head then
                if not targetDotGui or targetDotGui.Parent ~= head then
                    clearTargetVis()
                    targetDotGui = Instance.new("BillboardGui")
                    targetDotGui.Name = "TargetDot"
                    targetDotGui.Adornee = head
                    targetDotGui.Size = UDim2.new(0, 10, 0, 10)
                    targetDotGui.StudsOffsetWorldSpace = Vector3.new(0, 6, 0)
                    targetDotGui.AlwaysOnTop = true
                    targetDotGui.LightInfluence = 0
                    targetDotGui.ResetOnSpawn = false
                    
                    local dot = Instance.new("Frame")
                    dot.Name = "Dot"
                    dot.BackgroundColor3 = flags.targetVisColor
                    dot.BorderSizePixel = 0
                    dot.Size = UDim2.new(1, 0, 1, 0)
                    dot.Parent = targetDotGui
                    
                    local corner = Instance.new("UICorner")
                    corner.CornerRadius = UDim.new(1, 0)
