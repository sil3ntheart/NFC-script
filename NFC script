local totemEntries = {}
local lastTotemUpdate = 0

local function createTotemLabel(part)
    local b = Instance.new("BillboardGui")
    b.Name = "TotemLabel"
    b.Adornee = part
    b.Size = UDim2.new(0, 220, 0, 20)
    b.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    b.AlwaysOnTop = true
    b.LightInfluence = 0
    b.ResetOnSpawn = false
    b.Enabled = false
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 14
    lbl.TextColor3 = flags.totemColor
    lbl.TextStrokeTransparency = 0.3
    lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
    lbl.Text = ""
    lbl.Parent = b
    b.Parent = part
    totemEntries[part] = b
    return b
end

local function removeTotemObjects(part)
    local b = totemEntries[part]
    if b then pcall(function() b:Destroy() end) end
    totemEntries[part] = nil
end

local function renderTotems()
    local mapFolder = workspace:FindFirstChild("map")
    local totemFolder = mapFolder and mapFolder:FindFirstChild("Totems")
    if not totemFolder then
        for part in pairs(totemEntries) do removeTotemObjects(part) end
        return
    end
    local active = {}
    local camPos = Camera.CFrame.Position
    for _, t in ipairs(totemFolder:GetChildren()) do
        if string.find(string.lower(t.Name), "totem", 1, true) and t:IsA("BasePart") then
            active[t] = true
            local b = totemEntries[t] or createTotemLabel(t)
            if flags.totemESP then
                local dist = (camPos - t.Position).Magnitude
                local lbl = b:FindFirstChildOfClass("TextLabel")
                if lbl then
                    lbl.Text = string.format("Hollowed Totem (%d)", math.floor(dist))
                    lbl.TextColor3 = flags.totemColor
                end
                b.Enabled = true
            else
                b.Enabled = false
            end
        end
    end
    for p in pairs(totemEntries) do if not active[p] then removeTotemObjects(p) end end
end

if RunService then
    trackConn(RunService.RenderStepped:Connect(function()
        local now = tick()
        if (now - lastTotemUpdate) < 0.25 then return end
        lastTotemUpdate = now
        pcall(renderTotems)
    end))
end

