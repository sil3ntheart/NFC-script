local totemEntries = {}
local TOTEM_UPDATE_INTERVAL = 0.25
local lastTotemUpdate = 0

local function createTotemLabel(part)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TotemLabel"
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 220, 0, 20)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.ResetOnSpawn = false
    billboard.Enabled = false

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextColor3 = flags.totemColor
    label.TextStrokeTransparency = 0.3
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.Text = ""
    label.Parent = billboard

    billboard.Parent = part
    totemEntries[part] = billboard
    return billboard
end

local function removeTotemObjects(part)
    local b = totemEntries[part]
    if b then pcall(function() b:Destroy() end) end
    totemEntries[part] = nil
end

local function renderTotems()
    local mapFolder = workspace:FindFirstChild("map")
    local totemFolder = mapFolder and mapFolder:FindFirstChild("Totems")

    if not totemFolder then
        for part in pairs(totemEntries) do
            removeTotemObjects(part)
        end
        return
    end

    local activeTotems = {}
    local camPos = Camera.CFrame.Position

    for _, totem in ipairs(totemFolder:GetChildren()) do
        local lowerName = string.lower(totem.Name)
        if totem.Name == "Totem(PlaceHolder)" or string.find(lowerName, "totem", 1, true) then
            if totem:IsA("BasePart") then
                activeTotems[totem] = true
                local b = totemEntries[totem]
                if not b or not b.Parent then
                    b = createTotemLabel(totem)
                end

                if flags.totemESP then
                    local dist = (camPos - totem.Position).Magnitude
                    local label = b:FindFirstChildOfClass("TextLabel")
                    if label then
                        label.Text = string.format("Hollowed Totem (%d)", math.floor(dist))
                        label.TextColor3 = flags.totemColor
                    end
                    b.Enabled = true
                else
                    b.Enabled = false
                end
            end
        end
    end

    for part, b in pairs(totemEntries) do
        if not activeTotems[part] then
            removeTotemObjects(part)
        end
    end
end

trackConn(RunService.RenderStepped:Connect(function()
    local now = tick()
    if (now - lastTotemUpdate) < TOTEM_UPDATE_INTERVAL then return end
    lastTotemUpdate = now
    pcall(renderTotems)
end))

