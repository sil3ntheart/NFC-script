                    targetDotGui.Parent = head
                end
                local dot = targetDotGui:FindFirstChild("Dot")
                if dot then dot.BackgroundColor3 = flags.targetVisColor end
            end
        else
            clearTargetVis()
        end

        updateAimHitbox()
    end))
end

