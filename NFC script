-- ── Auto Bypass ─────────────────────────────────────────────
do
    pcall(function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local remote = ReplicatedStorage:FindFirstChild("AntiCheatRemote")
        if not remote then return end
        if type(getgc) ~= "function" or type(debug) ~= "table" then return end
        if type(debug.getinfo) ~= "function" or type(debug.getupvalue) ~= "function" then return end

        local WANTED_UPVALUES = 7

        local function holdsRemote(fn)
            for index = 1, WANTED_UPVALUES do
                local ok2, value = pcall(debug.getupvalue, fn, index)
                if ok2 and value == remote then return true end
            end
            return false
        end

        local function findFlag()
            local ok2, objects = pcall(getgc)
            if not ok2 or type(objects) ~= "table" then return nil end
            for _, value in ipairs(objects) do
                if type(value) == "function" then
                    local okInfo, info = pcall(debug.getinfo, value)
                    if okInfo and type(info) == "table" and info.nups == WANTED_UPVALUES then
                        if holdsRemote(value) then return value end
                    end
                end
            end
            return nil
        end

        local flag = findFlag()
        if not flag then return end

        if type(hookfunction) == "function" then
            pcall(hookfunction, flag, function() end)
            return
        end

        task.spawn(function()
            while true do
                for index = 1, WANTED_UPVALUES do
                    local ok2, value = pcall(debug.getupvalue, flag, index)
                    if ok2 then
                        if type(value) == "number" and value > 0 then
                            pcall(debug.setupvalue, flag, index, 0)
                        elseif type(value) == "table" then
                            pcall(table.clear, value)
                        end
                    end
                end
                task.wait(1)
            end
        end)
    end)
end

