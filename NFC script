local function getPlayerList()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not isFriend(p) then
            if p.DisplayName and p.DisplayName ~= p.Name then
                table.insert(list, p.Name .. " (" .. p.DisplayName .. ")")
            else
                table.insert(list, p.Name)
            end
        end
    end
    if #list == 0 then table.insert(list, "None") end
    return list
end

local function getCurrentAbility()
    local myEntry = getLivingEntry(LocalPlayer)
    if not myEntry then return nil end

    local equipped = myEntry:FindFirstChild("AbilityEquipped")
    if equipped and equipped:IsA("StringValue") and equipped.Value ~= "" then
        return equipped.Value
    end

    local casting = myEntry:FindFirstChild("CastingSpells")
    if casting then
        for _, v in ipairs(casting:GetChildren()) do
            if v:IsA("BoolValue") and v.Value == true then
                return v.Name
            end
        end
    end
    return nil
end

-- Single Target Rage Mode
local function startRageMode(enabled)
    if not enabled then
        if rageConnection then rageConnection:Disconnect(); rageConnection = nil end
        return
    end
    
    if rageConnection or not RunService then return end
    
    rageConnection = RunService.Heartbeat:Connect(function()
        if not flags.rageMode or flags.rageTarget == "" or flags.rageTarget == "None" then return end
        
        local targetName = string.match(flags.rageTarget, "^([^%s]+)")
        if not targetName then return end
        
        local targetModel = workspace:FindFirstChild("LivingThings") and workspace.LivingThings:FindFirstChild(targetName)
        if not targetModel then return end
        
        local ability = getCurrentAbility()
        
        if ability and SpellHandler then
            pcall(function()
                SpellHandler:FireServer(targetModel, ability, nil)
            end)
        end
    end)
end

